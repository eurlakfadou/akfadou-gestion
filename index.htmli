<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Eurl Akfadou - Gestion Clients</title>
    <style>
        :root { --primary: #2563eb; --danger: #dc2626; --warning: #d97706; --success: #16a34a; --bg: #f8fafc; --card: #ffffff; --text: #1e293b; --border: #e2e8f0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 20px; }
        .container { max-width: 1200px; margin: 0 auto; }
        h1 { color: var(--primary); font-size: 24px; margin-bottom: 5px; }
        p.subtitle { color: #64748b; margin-top: 0; margin-bottom: 20px; }
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid var(--border); padding-bottom: 10px; flex-wrap: wrap; }
        .tab-btn { background: none; border: none; font-size: 15px; font-weight: 600; cursor: pointer; color: #64748b; padding: 8px 16px; border-radius: 6px; transition: 0.2s; }
        .tab-btn.active { background: var(--primary); color: white; }
        .panel { display: none; background: var(--card); padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
        .panel.active { display: block; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 14px; }
        input, select { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; box-sizing: border-box; }
        button.action-btn { background: var(--primary); color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; }
        button.action-btn:hover { opacity: 0.9; }
        .btn-secondary { background: #64748b; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; margin-left: 10px; }
        .btn-filter { background: #e2e8f0; color: var(--text); border: none; padding: 8px 14px; border-radius: 6px; font-weight: 600; cursor: pointer; margin-right: 8px; font-size: 13px; }
        .btn-filter.active { background: var(--primary); color: white; }
        .btn-danger { background: var(--danger); color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
        .btn-warning { background: var(--warning); color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; margin-right: 5px; }
        .btn-success { background: var(--success); color: white; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 15px;}
        .btn-export-json { background: #7c3aed; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
        .btn-export-csv { background: #0284c7; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); font-size: 14px; }
        th { background: #f1f5f9; font-weight: 600; }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
        .stat-card { background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid var(--border); }
        .stat-card h3 { margin: 0 0 5px 0; font-size: 14px; color: #64748b; }
        .stat-card p { margin: 0; font-size: 20px; font-weight: bold; color: var(--primary); }
        .reduc-box { background: #f1f5f9; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--border); display: flex; gap: 15px; align-items: flex-end; }

        @media print {
            body * { visibility: hidden; }
            #detailsClientContent, #detailsClientContent * { visibility: visible; }
            #detailsClientContent { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print, button { display: none !important; }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Eurl Akfadou - Gestion Clients</h1>
    <p class="subtitle">Application de gestion intégrée</p>

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('recherche', event)">Recherche & Historique</button>
        <button class="tab-btn" onclick="switchTab('global', event)">📊 Historique Global & Crédits</button>
        <button class="tab-btn" onclick="switchTab('clients', event)">Clients</button>
        <button class="tab-btn" onclick="switchTab('produits', event)">Produits</button>
        <button class="tab-btn" onclick="switchTab('achats', event)">Saisir un Achat</button>
        <button class="tab-btn" onclick="switchTab('paiements', event)">Enregistrer Paiement</button>
    </div>

    <!-- RECHERCHE CLIENT & HISTORIQUE -->
    <div id="recherche" class="panel active">
        <!-- BARRE D'EXPORTATION RAPIDE -->
        <div class="no-print" style="display: flex; gap: 10px; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid var(--border); flex-wrap: wrap;">
            <button class="btn-export-json" onclick="exporterEnJSON()">📥 Sauvegarde complète (JSON)</button>
            <button class="btn-export-csv" onclick="exporterEnCSV()">📊 Exporter les achats (CSV / Excel)</button>
        </div>

        <h2>Recherche Client & Historique Direct</h2>
        <div class="form-group">
            <label>Sélectionner ou chercher un client (trié de A à Z) :</label>
            <select id="selectClientRecherche" onchange="chargerClientFiche()"></select>
        </div>
        <div id="detailsClientContent" style="display:none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
                <h2 id="titreClientFiche" style="color: var(--primary); margin:0;"></h2>
                <button class="btn-success" onclick="window.print()">🖨️ Imprimer la fiche client</button>
            </div>
            
            <div class="stats-grid" style="margin-top: 15px;">
                <div class="stat-card"><h3>Total Achats</h3><p id="statAchats">0 DA</p></div>
                <div class="stat-card"><h3>Total Payé</h3><p id="statPaye">0 DA</p></div>
                <div class="stat-card"><h3>Reste à Payer (Solde)</h3><p id="statSolde" style="color: var(--danger);">0 DA</p></div>
            </div>

            <!-- BLOC RÉDUCTION GLOBALE SUR LA FICHE CLIENT -->
            <div class="reduc-box no-print">
                <div style="flex: 1;">
                    <label>Type de réduction globale</label>
                    <select id="typeReducClient">
                        <option value="montant">Montant fixe (DA)</option>
                        <option value="pourcent">Pourcentage (%)</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label>Valeur de la réduction</label>
                    <input type="number" id="valeurReducClient" value="0" placeholder="Ex: 500 ou 10">
                </div>
                <div>
                    <button class="action-btn" onclick="appliquerReductionClient()">Appliquer la réduction</button>
                </div>
            </div>

            <h3>Historique des Achats</h3>
            <table>
                <thead><tr><th>Date</th><th>Produit</th><th>Qté</th><th>Prix U.</th><th>Total Ligne</th><th class="no-print">Actions</th></tr></thead>
                <tbody id="tableHistAchats"></tbody>
            </table>

            <h3 style="margin-top:25px; color: var(--primary);">📦 Total des quantités achetées par produit</h3>
            <table>
                <thead><tr><th>Produit</th><th>Quantité Totale Achetée</th></tr></thead>
                <tbody id="tableTotalProduitsClient"></tbody>
            </table>

            <h3 style="margin-top:30px;">Historique des Paiements</h3>
            <table>
                <thead><tr><th>Date</th><th>Montant</th><th>Mode</th><th>Référence / Numéro</th><th class="no-print">Action</th></tr></thead>
                <tbody id="tableHistPaiements"></tbody>
            </table>
        </div>
    </div>

    <!-- HISTORIQUE GLOBAL & CREDITS -->
    <div id="global" class="panel">
        <h2>Historique Global et Crédits Clients</h2>
        
        <h3 style="margin-top: 20px; color: var(--danger);">⚠️ Situation des Crédits (Restes à payer par client)</h3>
        <table>
            <thead><tr><th>Client</th><th>Total Achats (avec Ancien Crédit)</th><th>Total Payé</th><th>Reste à Payer (Crédit)</th></tr></thead>
            <tbody id="tableCreditsGlobal"></tbody>
        </table>

        <h3 style="margin-top: 40px;">Tous les Achats (Trier par)</h3>
        <div style="margin-bottom: 15px;">
            <button class="btn-filter active" id="btnTriDate" onclick="changerTri('date')">📅 Date (Plus récent)</button>
            <button class="btn-filter" id="btnTriNom" onclick="changerTri('nom')">👤 Nom du Client (A-Z)</button>
            <button class="btn-filter" id="btnTriMontant" onclick="changerTri('montant')">💰 Montant (Plus élevé)</button>
        </div>
        <table>
            <thead><tr><th>Date</th><th>Client</th><th>Produit</th><th>Qté</th><th>Prix U.</th><th>Total</th></tr></thead>
            <tbody id="tableGlobalAchats"></tbody>
        </table>
    </div>

    <!-- CLIENTS -->
    <div id="clients" class="panel">
        <h2 id="titreClientForm">Gestion des Clients (Ajout)</h2>
        <input type="hidden" id="editClientIndex" value="">
        <div class="form-group"><label>Nom / Raison Sociale</label><input type="text" id="cliNom"></div>
        <div class="form-group"><label>Téléphone</label><input type="text" id="cliTel"></div>
        <div class="form-group"><label>Adresse</label><input type="text" id="cliAdresse"></div>
        <div class="form-group"><label>Ancien Crédit Initial (DA)</label><input type="number" id="cliAncienCredit" value="0" placeholder="Ex: 5000"></div>
        <button class="action-btn" id="btnValiderClient" onclick="enregistrerClient()">Enregistrer le client</button>
        <button class="btn-danger" id="btnAnnulerClient" onclick="annulerEditClient()" style="display:none; margin-left: 10px;">Annuler</button>
        
        <h3 style="margin-top:30px;">Liste des clients enregistrés</h3>
        <table><thead><tr><th>Nom</th><th>Téléphone</th><th>Adresse</th><th>Ancien Crédit</th><th>Actions</th></tr></thead><tbody id="tableClients"></tbody></table>
    </div>

    <!-- PRODUITS -->
    <div id="produits" class="panel">
        <h2 id="titreProduitForm">Catalogue des Produits (Ajout)</h2>
        <input type="hidden" id="editProduitIndex" value="">
        <div class="form-group"><label>Nom du Produit</label><input type="text" id="prodNom"></div>
        <div class="form-group"><label>Prix Unitaire (DA)</label><input type="number" id="prodPrix"></div>
        <button class="action-btn" id="btnValiderProduit" onclick="enregistrerProduit()">Ajouter au catalogue</button>
        <button class="btn-danger" id="btnAnnulerProduit" onclick="annulerEditProduit()" style="display:none; margin-left: 10px;">Annuler</button>

        <h3 style="margin-top:30px;">Liste des produits</h3>
        <table><thead><tr><th>Produit</th><th>Prix Unitaire</th><th>Actions</th></tr></thead><tbody id="tableProduits"></tbody></table>
    </div>

    <!-- ACHATS -->
    <div id="achats" class="panel">
        <h2 id="titreAchatForm">Saisir un Achat / Vente</h2>
        <input type="hidden" id="editAchatIndex" value="">
        <div class="form-group"><label>Client</label><select id="achatClient"></select></div>
        <div class="form-group"><label>Produit</label><select id="achatProduit" onchange="remplirPrix()"></select></div>
        <div class="form-group"><label>Quantité</label><input type="number" id="achatQte" value="1"></div>
        <div class="form-group"><label>Prix Unitaire (DA)</label><input type="number" id="achatPrix"></div>
        <div class="form-group"><label>Date</label><input type="date" id="achatDate"></div>
        <button class="action-btn" id="btnValiderAchat" onclick="ajouterAchat()">Valider l'achat</button>
        <button class="btn-secondary" onclick="viderFormulaireAchat()">🧹 Vider / Nouveau</button>
        <button class="btn-danger" id="btnAnnulerAchat" onclick="annulerEditAchat()" style="display:none; margin-left: 10px;">Annuler</button>
    </div>

    <!-- PAIEMENTS -->
    <div id="paiements" class="panel">
        <h2>Enregistrer un Paiement</h2>
        <div class="form-group"><label>Client</label><select id="paiementClient"></select></div>
        <div class="form-group"><label>Montant (DA)</label><input type="number" id="paiementMontant"></div>
        <div class="form-group">
            <label>Mode de paiement</label>
            <select id="paiementMode" onchange="gererChampNumero()">
                <option value="Espèces">Espèces</option>
                <option value="Chèque">Chèque</option>
                <option value="Virement">Virement</option>
            </select>
        </div>
        <div class="form-group" id="groupeNumero" style="display:none;">
            <label id="labelNumero">Numéro</label>
            <input type="text" id="paiementNumero" placeholder="Entrez le numéro...">
        </div>
        <div class="form-group"><label>Date</label><input type="date" id="paiementDate"></div>
        <button class="action-btn" onclick="ajouterPaiement()">Enregistrer le versement</button>
        <button class="btn-secondary" onclick="viderFormulairePaiement()">🧹 Vider / Nouveau</button>
    </div>
</div>

<script>
    let db = JSON.parse(localStorage.getItem('akfadou_db')) || { clients: [], produits: [], achats: [], paiements: [] };
    let critereTri = 'date';

    function saveData() { localStorage.setItem('akfadou_db', JSON.stringify(db)); remplirListes(); }

    function switchTab(tabId, evt) {
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        if(evt && evt.currentTarget) { evt.currentTarget.classList.add('active'); }
        if(tabId === 'recherche') remplirSelectRecherche();
        if(tabId === 'global') afficherHistoriqueGlobal();
    }

    // --- FONCTIONS D'EXPORTATION ---
    function exporterEnJSON() {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", "sauvegarde_akfadou_" + new Date().toISOString().split('T')[0] + ".json");
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
    }

    function exporterEnCSV() {
        let csvContent = "\uFEFFDate;Client;Produit;Quantité;Prix Unitaire (DA);Total (DA)\n";
        db.achats.forEach(a => {
            let ligne = `"${a.date}";"${a.client.replace(/"/g, '""')}";"${a.produit.replace(/"/g, '""')}";${a.qte};${a.prix};${a.total}`;
            csvContent += ligne + "\n";
        });

        const encodedUri = encodeURI("data:text/csv;charset=utf-8," + csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "achats_akfadou_" + new Date().toISOString().split('T')[0] + ".csv");
        document.body.appendChild(link);
        link.click();
        link.remove();
    }
    // -------------------------------

    function enregistrerClient() {
        let nom = document.getElementById('cliNom').value.trim();
        let tel = document.getElementById('cliTel').value;
        let adresse = document.getElementById('cliAdresse').value;
        let ancienCredit = parseFloat(document.getElementById('cliAncienCredit').value) || 0;
        let index = document.getElementById('editClientIndex').value;

        if(!nom) return alert('Veuillez entrer un nom.');

        if(index === "") {
            db.clients.push({ nom, tel, adresse, ancienCredit, reducType: 'montant', reducVal: 0 });
            alert('Client enregistré !');
        } else {
            let ancienNom = db.clients[index].nom;
            db.achats.forEach(a => { if(a.client === ancienNom) a.client = nom; });
            db.paiements.forEach(p => { if(p.client === ancienNom) p.client = nom; });
            db.clients[index].nom = nom;
            db.clients[index].tel = tel;
            db.clients[index].adresse = adresse;
            db.clients[index].ancienCredit = ancienCredit;
            alert('Client modifié avec succès !');
            annulerEditClient();
        }
        saveData();
    }

    function preparerModifClient(index) {
        let c = db.clients[index];
        document.getElementById('cliNom').value = c.nom;
        document.getElementById('cliTel').value = c.tel;
        document.getElementById('cliAdresse').value = c.adresse;
        document.getElementById('cliAncienCredit').value = c.ancienCredit || 0;
        document.getElementById('editClientIndex').value = index;
        document.getElementById('titreClientForm').innerText = "Modifier le client";
        document.getElementById('btnValiderClient').innerText = "Mettre à jour";
        document.getElementById('btnAnnulerClient').style.display = "inline-block";
    }

    function annulerEditClient() {
        document.getElementById('cliNom').value = ''; document.getElementById('cliTel').value = ''; document.getElementById('cliAdresse').value = '';
        document.getElementById('cliAncienCredit').value = '0';
        document.getElementById('editClientIndex').value = "";
        document.getElementById('titreClientForm').innerText = "Gestion des Clients (Ajout)";
        document.getElementById('btnValiderClient').innerText = "Enregistrer le client";
        document.getElementById('btnAnnulerClient').style.display = "none";
    }

    function supprimerClient(index) {
        if(confirm("Voulez-vous vraiment supprimer ce client ?")) {
            let nom = db.clients[index].nom;
            db.clients.splice(index, 1);
            saveData();
            if(document.getElementById('selectClientRecherche').value === nom) {
                document.getElementById('selectClientRecherche').value = "";
                afficherHistoriqueClient();
            }
        }
    }

    function enregistrerProduit() {
        let nom = document.getElementById('prodNom').value.trim();
        let prix = document.getElementById('prodPrix').value;
        let index = document.getElementById('editProduitIndex').value;
        if(!nom || !prix) return alert('Remplissez tous les champs.');
        if(index === "") {
            db.produits.push({ nom, prix: parseFloat(prix) });
            alert('Produit ajouté !');
        } else {
            db.produits[index] = { nom, prix: parseFloat(prix) };
            alert('Produit modifié !');
            annulerEditProduit();
        }
        saveData();
    }

    function preparerModifProduit(index) {
        let p = db.produits[index];
        document.getElementById('prodNom').value = p.nom;
        document.getElementById('prodPrix').value = p.prix;
        document.getElementById('editProduitIndex').value = index;
        document.getElementById('titreProduitForm').innerText = "Modifier le produit";
        document.getElementById('btnValiderProduit').innerText = "Mettre à jour";
        document.getElementById('btnAnnulerProduit').style.display = "inline-block";
    }

    function annulerEditProduit() {
        document.getElementById('prodNom').value = ''; document.getElementById('prodPrix').value = '';
        document.getElementById('editProduitIndex').value = "";
        document.getElementById('titreProduitForm').innerText = "Catalogue des Produits (Ajout)";
        document.getElementById('btnValiderProduit').innerText = "Ajouter au catalogue";
        document.getElementById('btnAnnulerProduit').style.display = "none";
    }

    function supprimerProduit(index) {
        if(confirm("Voulez-vous supprimer ce produit du catalogue ?")) {
            db.produits.splice(index, 1);
            saveData();
        }
    }

    function ajouterAchat() {
        let client = document.getElementById('achatClient').value;
        let produit = document.getElementById('achatProduit').value;
        let qte = parseFloat(document.getElementById('achatQte').value) || 1;
        let prix = parseFloat(document.getElementById('achatPrix').value) || 0;
        let date = document.getElementById('achatDate').value || new Date().toISOString().split('T')[0];
        let index = document.getElementById('editAchatIndex').value;

        if(!client || !produit) return alert('Sélectionnez un client et un produit.');

        let total = qte * prix;
        let achatObj = { client, produit, qte, prix, total, date };

        if(index === "") {
            db.achats.push(achatObj);
            alert('Achat enregistré avec succès !');
        } else {
            db.achats[index] = achatObj;
            alert('Achat mis à jour avec succès !');
            annulerEditAchat();
        }
        saveData();
        afficherHistoriqueClient();
    }

    function preparerModifAchat(indexGlobal) {
        let a = db.achats[indexGlobal];
        document.getElementById('achatClient').value = a.client;
        document.getElementById('achatProduit').value = a.produit;
        document.getElementById('achatQte').value = a.qte;
        document.getElementById('achatPrix').value = a.prix;
        document.getElementById('achatDate').value = a.date;
        document.getElementById('editAchatIndex').value = indexGlobal;
        
        document.getElementById('titreAchatForm').innerText = "Modifier l'achat";
        document.getElementById('btnValiderAchat').innerText = "Mettre à jour l'achat";
        document.getElementById('btnAnnulerAchat').style.display = "inline-block";

        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('achats').classList.add('active');
        document.querySelectorAll('.tab-btn')[4].classList.add('active');
    }

    function annulerEditAchat() {
        viderFormulaireAchat();
        document.getElementById('editAchatIndex').value = "";
        document.getElementById('titreAchatForm').innerText = "Saisir un Achat / Vente";
        document.getElementById('btnValiderAchat').innerText = "Valider l'achat";
        document.getElementById('btnAnnulerAchat').style.display = "none";
    }

    function viderFormulaireAchat() {
        document.getElementById('achatClient').value = "";
        document.getElementById('achatProduit').value = "";
        document.getElementById('achatQte').value = "1";
        document.getElementById('achatPrix').value = "";
        document.getElementById('achatDate').value = "";
    }

    function supprimerAchat(indexGlobal) {
        if(confirm("Voulez-vous supprimer cette ligne d'achat ?")) {
            db.achats.splice(indexGlobal, 1);
            saveData();
            afficherHistoriqueClient();
            afficherHistoriqueGlobal();
        }
    }

    function gererChampNumero() {
        let mode = document.getElementById('paiementMode').value;
        let groupe = document.getElementById('groupeNumero');
        let label = document.getElementById('labelNumero');
        if(mode === 'Chèque') { groupe.style.display = 'block'; label.innerText = 'Numéro de Chèque'; }
        else if(mode === 'Virement') { groupe.style.display = 'block'; label.innerText = 'Numéro de Virement'; }
        else { groupe.style.display = 'none'; document.getElementById('paiementNumero').value = ''; }
    }

    function ajouterPaiement() {
        let client = document.getElementById('paiementClient').value;
        let montant = parseFloat(document.getElementById('paiementMontant').value);
        let mode = document.getElementById('paiementMode').value;
        let numero = document.getElementById('paiementNumero').value;
        let date = document.getElementById('paiementDate').value || new Date().toISOString().split('T')[0];
        if(!client || !montant) return alert('Remplissez les champs obligatoires.');
        if((mode === 'Chèque' || mode === 'Virement') && !numero) return alert('Veuillez entrer le numéro.');
        db.paiements.push({ client, montant, mode, numero: (mode !== 'Espèces' ? numero : '-'), date });
        saveData();
        alert('Paiement enregistré !');
        afficherHistoriqueClient();
    }

    function viderFormulairePaiement() {
        document.getElementById('paiementClient').value = "";
        document.getElementById('paiementMontant').value = "";
        document.getElementById('paiementMode').value = "Espèces";
        document.getElementById('paiementNumero').value = "";
        document.getElementById('groupeNumero').style.display = "none";
        document.getElementById('paiementDate').value = "";
    }

    function supprimerPaiement(indexGlobal) {
        if(confirm("Voulez-vous supprimer ce versement ?")) {
            db.paiements.splice(indexGlobal, 1);
            saveData();
            afficherHistoriqueClient();
        }
    }

    function remplirListes() {
        let clientsTries = [...db.clients].sort((a, b) => a.nom.localeCompare(b.nom));
        let produitsTries = [...db.produits].sort((a, b) => a.nom.localeCompare(b.nom));

        let cSelects = [document.getElementById('achatClient'), document.getElementById('paiementClient'), document.getElementById('selectClientRecherche')];
        cSelects.forEach(s => { 
            if(s) { 
                let valActuelle = s.value;
                s.innerHTML = '<option value="">-- Choisir un client --</option>'; 
                clientsTries.forEach(c => s.innerHTML += `<option value="${c.nom}">${c.nom}</option>`); 
                s.value = valActuelle;
            } 
        });
        
        let pSelect = document.getElementById('achatProduit');
        if(pSelect) {
            let valActuelleProd = pSelect.value;
            pSelect.innerHTML = '<option value="">-- Choisir un produit --</option>';
            produitsTries.forEach(p => pSelect.innerHTML += `<option value="${p.nom}" data-prix="${p.prix}">${p.nom} (${p.prix} DA)</option>`);
            pSelect.value = valActuelleProd;
        }

        document.getElementById('tableClients').innerHTML = clientsTries.map((c) => {
            let realIndex = db.clients.findIndex(orig => orig.nom === c.nom);
            return `<tr><td>${c.nom}</td><td>${c.tel || '-'}</td><td>${c.adresse || '-'}</td><td><b>${c.ancienCredit || 0} DA</b></td><td><button class="btn-warning" onclick="preparerModifClient(${realIndex})">Modifier</button><button class="btn-danger" onclick="supprimerClient(${realIndex})">Supprimer</button></td></tr>`;
        }).join('') || '<tr><td colspan="5" style="text-align:center; color:#64748b;">Aucun client enregistré.</td></tr>';

        document.getElementById('tableProduits').innerHTML = produitsTries.map((p) => {
            let realIndex = db.produits.findIndex(orig => orig.nom === p.nom);
            return `<tr><td>${p.nom}</td><td>${p.prix} DA</td><td><button class="btn-warning" onclick="preparerModifProduit(${realIndex})">Modifier</button><button class="btn-danger" onclick="supprimerProduit(${realIndex})">Supprimer</button></td></tr>`;
        }).join('') || '<tr><td colspan="3" style="text-align:center; color:#64748b;">Aucun produit enregistré.</td></tr>';
    }

    function remplirPrix() {
        let select = document.getElementById('achatProduit');
        let option = select.options[select.selectedIndex];
        document.getElementById('achatPrix').value = option.getAttribute('data-prix') || 0;
    }

    function remplirSelectRecherche() {
        let s = document.getElementById('selectClientRecherche');
        let valActuelle = s.value;
        let clientsTries = [...db.clients].sort((a, b) => a.nom.localeCompare(b.nom));
        s.innerHTML = '<option value="">-- Sélectionnez un client pour voir son historique --</option>';
        clientsTries.forEach(c => s.innerHTML += `<option value="${c.nom}">${c.nom}</option>`);
        s.value = valActuelle;
    }

    function chargerClientFiche() {
        let clientNom = document.getElementById('selectClientRecherche').value;
        let container = document.getElementById('detailsClientContent');
        if(!clientNom) { container.style.display = 'none'; return; }
        
        let clientObj = db.clients.find(c => c.nom === clientNom);
        if(clientObj) {
            document.getElementById('typeReducClient').value = clientObj.reducType || 'montant';
            document.getElementById('valeurReducClient').value = clientObj.reducVal || 0;
        }
        afficherHistoriqueClient();
    }

    function appliquerReductionClient() {
        let clientNom = document.getElementById('selectClientRecherche').value;
        if(!clientNom) return alert('Sélectionnez d\'abord un client.');

        let typeReduc = document.getElementById('typeReducClient').value;
        let valeurReduc = parseFloat(document.getElementById('valeurReducClient').value) || 0;

        let clientObj = db.clients.find(c => c.nom === clientNom);
        if(clientObj) {
            clientObj.reducType = typeReduc;
            clientObj.reducVal = valeurReduc;
            saveData();
            alert('Réduction globale appliquée à la fiche du client !');
            afficherHistoriqueClient();
        }
    }

    function afficherHistoriqueClient() {
        let clientNom = document.getElementById('selectClientRecherche').value;
        let container = document.getElementById('detailsClientContent');
        if(!clientNom) { container.style.display = 'none'; return; }
        container.style.display = 'block';

        document.getElementById('titreClientFiche').innerText = "Fiche Client : " + clientNom;

        let achatsCli = db.achats.map((a, index) => ({...a, indexGlobal: index})).filter(a => a.client === clientNom);
        let paiementsCli = db.paiements.map((p, index) => ({...p, indexGlobal: index})).filter(p => p.client === clientNom);

        let clientObj = db.clients.find(c => c.nom === clientNom);
        let ancienCredit = clientObj ? (clientObj.ancienCredit || 0) : 0;
        let totAchatsBrut = achatsCli.reduce((sum, a) => sum + a.total, 0) + ancienCredit;

        let reducType = clientObj ? (clientObj.reducType || 'montant') : 'montant';
        let reducVal = clientObj ? (clientObj.reducVal || 0) : 0;

        let totAchatsFinal = totAchatsBrut;
        if(reducVal > 0) {
            if(reducType === 'montant') {
                totAchatsFinal = totAchatsBrut - reducVal;
            } else {
                totAchatsFinal = totAchatsBrut - (totAchatsBrut * (reducVal / 100));
            }
            if(totAchatsFinal < 0) totAchatsFinal = 0;
        }

        let totPaye = paiementsCli.reduce((sum, p) => sum + p.montant, 0);
        let solde = totAchatsFinal - totPaye;

        let affichageAchats = totAchatsBrut + ' DA';
        if(ancienCredit > 0) {
            affichageAchats += ` <span style="font-size: 12px; color: var(--warning);">(Inclus ancien crédit : ${ancienCredit} DA)</span>`;
        }
        if(reducVal > 0) {
            let texteReduc = reducType === 'pourcent' ? reducVal + '%' : reducVal + ' DA';
            affichageAchats = `<span style="text-decoration: line-through; color: #94a3b8; font-size: 16px;">${totAchatsBrut} DA</span><br><b>${totAchatsFinal} DA</b> <span style="font-size: 12px; color: var(--warning);">(Rép. -${texteReduc})</span>`;
        }

        document.getElementById('statAchats').innerHTML = affichageAchats;
        document.getElementById('statPaye').innerText = totPaye + ' DA';
        document.getElementById('statSolde').innerText = solde + ' DA';

        document.getElementById('tableHistAchats').innerHTML = achatsCli.map(a => `<tr><td>${a.date}</td><td>${a.produit}</td><td>${a.qte}</td><td>${a.prix} DA</td><td><b>${a.total} DA</b></td><td class="no-print"><button class="btn-warning" onclick="preparerModifAchat(${a.indexGlobal})">Modifier</button><button class="btn-danger" onclick="supprimerAchat(${a.indexGlobal})">Supprimer</button></td></tr>`).join('') || '<tr><td colspan="6">Aucun achat récent enregistré.</td></tr>';
        
        let qteParProduit = {};
        achatsCli.forEach(a => { qteParProduit[a.produit] = (qteParProduit[a.produit] || 0) + a.qte; });
        let qteArray = Object.keys(qteParProduit).map(prod => ({ produit: prod, qteTotale: qteParProduit[prod] }));
        document.getElementById('tableTotalProduitsClient').innerHTML = qteArray.map(q => 
            `<tr><td><b>${q.produit}</b></td><td><b>${q.qteTotale}</b></td></tr>`
        ).join('') || '<tr><td colspan="2" style="text-align:center; color:#64748b;">Aucun produit acheté.</td></tr>';

        document.getElementById('tableHistPaiements').innerHTML = paiementsCli.map(p => `<tr><td>${p.date}</td><td><b>${p.montant} DA</b></td><td>${p.mode}</td><td>${p.numero}</td><td class="no-print"><button class="btn-danger" onclick="supprimerPaiement(${p.indexGlobal})">Supprimer</button></td></tr>`).join('') || '<tr><td colspan="5">Aucun paiement enregistré.</td></tr>';
    }

    function changerTri(critere) {
        critereTri = critere;
        document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
        if(critere === 'date') document.getElementById('btnTriDate').classList.add('active');
        if(critere === 'nom') document.getElementById('btnTriNom').classList.add('active');
        if(critere === 'montant') document.getElementById('btnTriMontant').classList.add('active');
        afficherHistoriqueGlobal();
    }

    function afficherHistoriqueGlobal() {
        let creditsParClient = {};
        db.clients.forEach(c => {
            let totA = db.achats.filter(a => a.client === c.nom).reduce((s, a) => s + a.total, 0) + (c.ancienCredit || 0);
            if(c.reducVal && c.reducVal > 0) {
                if(c.reducType === 'pourcent') totA = totA - (totA * (c.reducVal / 100));
                else totA = totA - c.reducVal;
                if(totA < 0) totA = 0;
            }
            let totP = db.paiements.filter(p => p.client === c.nom).reduce((s, p) => s + p.montant, 0);
            creditsParClient[c.nom] = { achats: totA, paye: totP, reste: totA - totP };
        });

        let creditsArray = Object.keys(creditsParClient).map(nom => ({ nom, ...creditsParClient[nom] }));
        creditsArray.sort((a, b) => b.reste - a.reste);

        document.getElementById('tableCreditsGlobal').innerHTML = creditsArray.map(c => 
            `<tr><td><b>${c.nom}</b></td><td>${c.achats} DA</td><td>${c.paye} DA</td><td><b style="color: ${c.reste > 0 ? 'var(--danger)' : 'var(--success)'};">${c.reste} DA</b></td></tr>`
        ).join('') || '<tr><td colspan="4" style="text-align:center; color:#64748b;">Aucun client enregistré.</td></tr>';

        let achatsGlobal = [...db.achats];
        if(critereTri === 'date') {
            achatsGlobal.sort((a, b) => new Date(b.date) - new Date(a.date));
        } else if(critereTri === 'nom') {
            achatsGlobal.sort((a, b) => a.client.localeCompare(b.client));
        } else if(critereTri === 'montant') {
            achatsGlobal.sort((a, b) => b.total - a.total);
        }

        document.getElementById('tableGlobalAchats').innerHTML = achatsGlobal.map(a => `<tr><td>${a.date}</td><td><b>${a.client}</b></td><td>${a.produit}</td><td>${a.qte}</td><td>${a.prix} DA</td><td><b>${a.total} DA</b></td></tr>`).join('') || '<tr><td colspan="6" style="text-align:center; color:#64748b;">Aucun achat enregistré.</td></tr>';
    }

    window.onload = remplirListes;
</script>
</body>
</html>
